.{
    .sandboxing_mode = .threaded,

    .cluster = .development,
    .leader_schedule_file = "/var/lib/sig/schedule/schedule.txt",
    .gossip = .{
        .port = 8001,
        .advertise_tvu_port = true,
        .advertise_ip = "172.16.0.12",
        .development_entrypoints = .{"val-bootstrap:8001"},
    },
    .shred_network = .{
        .recv_port = 8002,
        .shred_version = 44604,
    },
    .telemetry = .{
        .port = 9110,
        .log_level = .info,
    },
    .snapshot = .{
        .folder = "/var/lib/sig/validator",
        .known_validators = .{"*"},
        .skip_on_cold_start = false,
    },
    .accounts_db = .{
        .file = "/var/lib/sig/validator/accounts.db",
        .rooted = .{ .gb = 1 },
        .unrooted = .{ .gb = 1 },
    },
}
